{
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": "src/**"
    },
    "api/team-sub.mjs": {
      "maxDuration": 60,
      "includeFiles": "src/**"
    }
  },
  "rewrites": [
    {
      "source": "/team-sub",
      "destination": "/api/team-sub"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
